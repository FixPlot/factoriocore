{
	"schemaVersion": 1,
	"id": "factoriocore",
	"version": "${1.0}",
	"name": "Factorio Core",
	"description": "Just Factorio, but in Minecraft.",
	"authors": [
		"FixPlot"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/factoriocore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.fixplot.factoriocore.FactorioCore"
		],
		"modmenu": [
"com.fixplot.factoriocore.client.config.FactorioModMenuIntegration"
],
"client": [
			"com.fixplot.factoriocore.client.FactorioCoreClient"
		]
	},
	"mixins": [
		"factoriocore.mixins.json",
		{
			"config": "factoriocore.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}